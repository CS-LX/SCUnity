    {
      "path": "Engine/Engine/Vector2.cs",
      "action": "patch",
      "inputSha256": "f88a08b8f3a16169f86492fd56723d9f025afacbd449142e5b4502baeb0e2130",
      "outputSha256": "3a8d49f767385c9a42c5df2368e30629c136a3e735685f67d758083dd8a5bb5c",
      "reason": "Replace unavailable SIMD intrinsics with four scalar float lanes, preserving lane and operation order. Match original .NET 10 scalar Transform/TransformNormal float rounding in Unity Mono using the same existing batch lane operations; ref overloads delegate without changing signatures.",
      "edits": [
        {
          "old": "using System.Runtime.Intrinsics;",
          "new": "using Vector128 = SCUnity.Compatibility.Float4;",
          "count": 1
        },
        {
          "old": "using System.Runtime.Intrinsics.X86;",
          "new": "using Sse = SCUnity.Compatibility.Float4;",
          "count": 1
        },
        {
          "old": "Vector128<float>",
          "new": "SCUnity.Compatibility.Float4",
          "count": 14
        },
        {
          "old": "public static Vector2 Transform(Vector2 v, Matrix m) => new(v.X * m.M11 + v.Y * m.M21 + m.M41, v.X * m.M12 + v.Y * m.M22 + m.M42);",
          "new": "public static Vector2 Transform(Vector2 v, Matrix m) {\n            TransformRows(ref m, out var row1, out var row2, out var row4);\n            var r = row1 * Vector128.Create(v.X) + row2 * Vector128.Create(v.Y) + row4;\n            return new Vector2(r[0], r[1]);\n        }",
          "count": 1
        },
        {
          "old": "public static void Transform(ref Vector2 v, ref Matrix m, out Vector2 result) {\r\n            result = new Vector2(v.X * m.M11 + v.Y * m.M21 + m.M41, v.X * m.M12 + v.Y * m.M22 + m.M42);\r\n        }",
          "new": "public static void Transform(ref Vector2 v, ref Matrix m, out Vector2 result) {\n            result = Transform(v, m);\n        }",
          "count": 1
        },
        {
          "old": "public static Vector2 TransformNormal(Vector2 v, Matrix m) => new(v.X * m.M11 + v.Y * m.M21, v.X * m.M12 + v.Y * m.M22);",
          "new": "public static Vector2 TransformNormal(Vector2 v, Matrix m) {\n            TransformRows(ref m, out var row1, out var row2, out _);\n            var r = row1 * Vector128.Create(v.X) + row2 * Vector128.Create(v.Y);\n            return new Vector2(r[0], r[1]);\n        }",
          "count": 1
        },
        {
          "old": "public static void TransformNormal(ref Vector2 v, ref Matrix m, out Vector2 result) {\r\n            result = new Vector2(v.X * m.M11 + v.Y * m.M21, v.X * m.M12 + v.Y * m.M22);\r\n        }",
          "new": "public static void TransformNormal(ref Vector2 v, ref Matrix m, out Vector2 result) {\n            result = TransformNormal(v, m);\n        }",
          "count": 1
        }
      ]
    },
