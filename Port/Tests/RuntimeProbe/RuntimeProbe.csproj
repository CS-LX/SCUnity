<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Engine" HintPath="$(BaselineOutput)/Engine.dll" />
    <Reference Include="EntitySystem" HintPath="$(BaselineOutput)/EntitySystem.dll" />
    <Reference Include="Survivalcraft" HintPath="$(BaselineOutput)/Survivalcraft.dll" />
    <Reference Include="0Harmony" HintPath="$(BaselineOutput)/0Harmony.dll" />
    <Reference Include="Silk.NET.Windowing.Common" HintPath="$(BaselineOutput)/Silk.NET.Windowing.Common.dll" />
    <Reference Include="Silk.NET.Windowing" HintPath="$(BaselineOutput)/Silk.NET.Windowing.dll" />
    <Reference Include="Silk.NET.Maths" HintPath="$(BaselineOutput)/Silk.NET.Maths.dll" />
  </ItemGroup>
</Project>
