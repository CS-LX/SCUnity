*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app

# Unity-generated asset data (keep other Assets and .meta files)
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa/
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/Plugins/Editor/JetBrains*

# Operating system files
.DS_Store
._*
Thumbs.db
Desktop.ini

# Local environment configuration
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Authored port tooling (Unity project files above remain ignored)
!/Port/**/*.csproj
/Port/.artifacts/
/Port/**/bin/
/Port/**/obj/
/Port/**/__pycache__/
